# ── Dependencies ──────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment & secrets ─────────────────────
.env
.env.*
!.env.example

# ── Uploaded files (runtime data, not source) ─
Files/*
!Files/.gitkeep

# ── Git ───────────────────────────────────────
.git
.gitignore

# ── CI / tooling ──────────────────────────────
.github
.husky

# ── Docs & tests ──────────────────────────────
README.md
*.md
__tests__
**/*.test.*
**/*.spec.*
coverage

# ── Development only ──────────────────────────
.DS_Store
Thumbs.db
*.log

# ── Docker itself ─────────────────────────────
Dockerfile
.dockerignore
docker-compose*.yml
